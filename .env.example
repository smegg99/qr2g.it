# qr2g.it backend environment.
# Copy to .env and fill in values for local dev.

# SQLite path is configured by db.path in config.json.

# Required for the public POST /api/v1/links endpoint when Turnstile is enabled.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Gin mode override; usually controlled via config.json.
# GIN_MODE=release

# Trusted proxy mode override; usually controlled via config.json.
# TRUSTED_PROXY_MODE=cloudflare

# Public base URL override; usually controlled via config.json.
# QR2G_PUBLIC_BASE_URL=https://qr2g.it

# Optional GitHub token for public-data reads; raises the hourly allowance for
# background availability and policy checks. Needs no repository scopes.
# GITHUB_TOKEN=

# Contact addresses revealed by POST /api/v1/contact/reveal. Never put them in
# frontend configuration.
# CONTACT_EMAIL=
# CONTACT_CATCHALL_EMAIL=
