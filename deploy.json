{
  "name": "qr2git",
  "build": [
    "cd web && pnpm install --frozen-lockfile",
    "cd web && pnpm build",
    "mkdir -p internal/frontend/dist bin && cp -a web/.output/public/. internal/frontend/dist/",
    "CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o bin/qr2git ."
  ],
  "run": [
    "bin/qr2git"
  ],
  "env": {
    "CONFIG_PATH": "config.json.deploy"
  },
  "require_env": [
    "TURNSTILE_SECRET_KEY",
    "TURNSTILE_SITE_KEY"
  ],
  "check": {
    "port": 9260,
    "path": "/ready",
    "timeout_seconds": 30
  }
}
