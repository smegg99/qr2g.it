{
  "contact": {
    "catchall": "@{env?:CONTACT_CATCHALL_EMAIL}",
    "email": "@{env?:CONTACT_EMAIL}"
  },
  "db": {
    "auto_migrate": true,
    "path": "data/qr2git.sqlite"
  },
  "github": {
    "api_version": "2026-03-10",
    "background_reserve": 15,
    "request_timeout_seconds": 15,
    "rest_base_url": "https://api.github.com",
    "token": "@{env?:GITHUB_TOKEN}",
    "user_agent": "qr2g.it"
  },
  "logger": {
    "dir": "",
    "frontend_console_log": true,
    "log_name": "qr2g.log",
    "max_age_days": 30,
    "max_backups": 5,
    "max_size_mb": 10,
    "no_color": false,
    "show_caller": false,
    "verbose": false
  },
  "policy": {
    "batch_size": 5,
    "enabled": true,
    "failure_backoff_seconds": 1800,
    "fresh_ttl_seconds": 86400,
    "interval_seconds": 60,
    "refresh_cooldown_seconds": 300
  },
  "preferences": {
    "language": "en"
  },
  "ratelimit": {
    "asset_per_min": 600,
    "cleanup_seconds": 600,
    "contact_per_min": 6,
    "create_per_day": 50,
    "create_per_min": 3,
    "github_burst": 20,
    "github_per_sec": 10,
    "miss_per_min": 60,
    "read_per_min": 120,
    "refresh_per_hour": 20,
    "resolve_per_min": 600,
    "shorthand_per_hour": 5
  },
  "server": {
    "canonical_base_url": "https://qr2g.it",
    "gin_mode": "release",
    "idle_timeout_seconds": 60,
    "listen_addr": "127.0.0.1:8080",
    "max_body_bytes": 4096,
    "public_base_url": "https://qr2g.it",
    "read_header_timeout_seconds": 5,
    "require_shorthand_turnstile": false,
    "service_name": "qr2g.it",
    "shutdown_timeout_seconds": 15,
    "trusted_proxy_mode": "cloudflare",
    "write_timeout_seconds": 15
  },
  "statistics": {
    "flush_interval_seconds": 10
  },
  "turnstile": {
    "enabled": true,
    "expected_hostname": "qr2g.it",
    "request_timeout_seconds": 5,
    "secret_key": "@{env?:TURNSTILE_SECRET_KEY}",
    "site_key": "@{pubenv?:TURNSTILE_SITE_KEY}",
    "siteverify_url": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "verifier": {
    "backoff_base_seconds": 30,
    "backoff_max_seconds": 3600,
    "batch_size": 50,
    "concurrency": 4,
    "enabled": true,
    "fresh_ttl_seconds": 3600,
    "interval_seconds": 60,
    "max_fail_count": 10,
    "request_timeout_seconds": 15,
    "stale_jitter_seconds": 600
  }
}
